@page "/customers"
@using BillingManagement.Client.Components.Customers

<PageTitle>Billing Management | Customers</PageTitle>

<main class="customers-page">
    <header class="customers-page-header">
        <div>
            <h1 tabindex="-1">Customers</h1>
            <p>Keep customer details ready for future billing documents.</p>
        </div>
        <a class="customers-create-button" href="/customers/create">Create customer</a>
    </header>

    <section class="customers-list" aria-labelledby="customers-list-title">
        @if (IsEditing)
        {
            <div class="customer-edit-header">
                <h2 id="customers-list-title">Edit customer</h2>
                <p>@editingCustomer!.CustomerName</p>
            </div>
            <form class="customer-edit-form" @onsubmit="SaveCustomer" @onsubmit:preventDefault novalidate>
                @if (!string.IsNullOrEmpty(GeneralError()))
                {
                    <p class="customer-edit-error-summary" role="alert">@GeneralError()</p>
                }
                <CustomerFormFields Form="editForm!" FieldError="FieldError" />
                <div class="customer-edit-actions">
                    <button class="customer-edit-cancel-button" type="button" @onclick="CancelEdit">Cancel</button>
                    <button class="customer-edit-save-button" type="submit" disabled="@isSubmitting">
                        @(isSubmitting ? "Saving..." : "Save changes")
                    </button>
                </div>
            </form>
        }
        else
        {
            <div class="customers-list-header">
                <div>
                    <h2 id="customers-list-title">Customer list</h2>
                    <p>Customer records will appear here.</p>
                </div>
                @if (!isLoading && loadError is null)
                {
                    <span class="customers-count">@totalCount @(totalCount == 1 ? "customer" : "customers")</span>
                }
            </div>

            @if (!isLoading && loadError is null)
            {
                <form class="document-filter customer-filter" @onsubmit="ApplySearch" @onsubmit:preventDefault>
                    <label><span>Search customers</span><input type="search" @bind="searchText" @bind:event="oninput" placeholder="Name, email, or Tax ID" /></label>
                    <button type="submit">Search</button>
                </form>
            }

            @if (deleteMessage is not null)
            {
                <p class="@DeleteMessageClass" role="@(deleteMessageIsError ? "alert" : "status")">@deleteMessage</p>
            }

            @if (isLoading)
            {
                <div class="customers-load-state" role="status">
                    <h2>Loading customers</h2>
                    <p>Checking saved customer records.</p>
                </div>
            }
            else if (loadError is not null)
            {
                <div class="customers-load-state" role="alert">
                    <h2>Could not load customers</h2>
                    <p>@loadError</p>
                    <button class="customers-retry-button" type="button" @onclick="RetryLoad">Retry</button>
                </div>
            }
            else
            {
                <div class="customers-table-wrap" tabindex="0" aria-label="Customer list">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Customer name</th>
                                <th scope="col">Email</th>
                                <th scope="col">Phone</th>
                                <th scope="col">Billing address</th>
                                <th scope="col"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in CustomerList)
                            {
                                <tr>
                                    <td>@customer.CustomerName</td>
                                    <td>@customer.Email</td>
                                    <td>@customer.Phone</td>
                                    <td>@BillingAddress(customer)</td>
                                    <td>
                                        <div class="customer-row-actions">
                                            <button class="customer-edit-button" type="button" @onclick="() => BeginEdit(customer)">Edit</button>
                                            <button class="customer-delete-button" type="button" @onclick="() => BeginDelete(customer)">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (CustomerList.Count > 0)
                {
                    <nav class="document-pagination" aria-label="Customer pages">
                        <button type="button" @onclick="PreviousPage" disabled="@(pageNumber == 1)">Previous</button>
                        <span>Page @pageNumber of @TotalPages</span>
                        <button type="button" @onclick="NextPage" disabled="@(pageNumber >= TotalPages)">Next</button>
                    </nav>
                }
                @if (CustomerList.Count == 0)
                {
                    <div class="customers-empty-state">
                        <h2>@(string.IsNullOrWhiteSpace(searchText) ? "No customers yet" : "No matching customers")</h2>
                        <p>@(string.IsNullOrWhiteSpace(searchText) ? "Create a customer to prepare future quotations and invoices." : "Try a different name, email, or Tax ID.")</p>
                        @if (string.IsNullOrWhiteSpace(searchText))
                        {
                            <a class="customers-create-button" href="/customers/create">Create customer</a>
                        }
                    </div>
                }
            }
        }
    </section>

    @if (showDeleteSnackbar)
    {
        <div class="@DeleteSnackbarClass" role="status" aria-label="Delete customer confirmation">
            <p>Delete customer? You can create a new customer later. Delete is blocked when quotations or invoices use this customer.</p>
            <div class="customer-delete-snackbar-actions">
                <button type="button" @onclick="CloseDeleteSnackbar">Cancel</button>
                <button type="button" class="danger" disabled="@isDeleting" @onclick="ConfirmDelete">
                    @(isDeleting ? "Deleting..." : "Delete")
                </button>
            </div>
        </div>
    }
</main>
