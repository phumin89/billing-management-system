@page "/invoices"

<PageTitle>Billing Management | Invoices</PageTitle>
<main class="document-page">
    <header class="document-page-header"><div><h1>Invoice archive</h1><p>Final billing documents created from accepted quotations.</p></div></header>
    <section class="document-register" aria-labelledby="invoice-list-title">
        <header class="document-register-header">
            <div>
                <h2 id="invoice-list-title">Invoice list</h2>
                <p>Issued billing documents and their current values.</p>
            </div>
            @if (!isLoading && error is null)
            {
                <span class="document-register-count">@items.Count @(items.Count == 1 ? "invoice" : "invoices")</span>
            }
        </header>
        @if (isLoading) { <div class="document-state" role="status"><strong>Opening the archive</strong><span>Loading invoice records...</span></div> }
        else if (error is not null) { <div class="document-state is-error" role="alert"><strong>The archive could not be opened</strong><span>@error</span></div> }
        else if (items.Count == 0) { <div class="document-state"><strong>No invoices filed yet</strong><span>Open a quotation when it is ready to become an invoice.</span><a class="text-link" href="/quotations">Open quotation register</a></div> }
        else
        {
            <div class="document-table-wrap" tabindex="0" aria-label="Invoice list">
                <table class="document-table">
                    <thead>
                        <tr>
                            <th scope="col">Reference</th>
                            <th scope="col">Customer</th>
                            <th scope="col">Issued</th>
                            <th scope="col">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td><a href="@($"/invoices/{item.Id}")">@item.Number</a></td>
                                <td>@item.CustomerName</td>
                                <td>@item.IssueDate.ToString("dd MMM yyyy")</td>
                                <td>@item.Total.ToString("N2") @item.Currency</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</main>
