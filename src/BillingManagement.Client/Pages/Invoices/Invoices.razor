@page "/invoices"

<PageTitle>Billing Management | Invoices</PageTitle>
<main class="document-page">
    <header class="document-page-header"><div><h1>Invoice archive</h1><p>Final billing documents created from accepted quotations.</p></div></header>
    <section class="document-register" aria-labelledby="invoice-list-title">
        <header class="document-register-header">
            <div>
                <h2 id="invoice-list-title">Invoice list</h2>
                <p>Issued billing documents and their current values.</p>
            </div>
            @if (!isLoading && error is null)
            {
                <span class="document-register-count">@TotalCount @(TotalCount == 1 ? "invoice" : "invoices")</span>
            }
        </header>
        @if (!isLoading && error is null)
        {
            <form class="document-filter" aria-label="Invoice filters" @onsubmit="ApplyFilters" @onsubmit:preventDefault>
                <label class="search-field">
                    <span class="visually-hidden">Search invoices</span>
                    <span class="search-input-shell">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
                        <input type="search" @bind="searchText" @bind:event="oninput" placeholder="Search by reference or customer" />
                    </span>
                </label>
                <label><span>Status</span><select @bind="statusFilter"><option>All</option><option>Issued</option><option>Overdue</option><option>Paid</option><option>Cancelled</option></select></label>
                <button class="search-submit" type="submit">Apply filters</button>
            </form>
        }
        @if (isLoading) { <div class="document-state" role="status"><strong>Opening the archive</strong><span>Loading invoice records...</span></div> }
        else if (error is not null) { <div class="document-state is-error" role="alert"><strong>The archive could not be opened</strong><span>@error</span></div> }
        else if (items.Count == 0) { <div class="document-state"><strong>@(FiltersApplied ? "No matching invoices" : "No invoices filed yet")</strong><span>@(FiltersApplied ? "Try a different reference, customer, or status." : "Open a quotation when it is ready to become an invoice.")</span>@if (!FiltersApplied) { <a class="text-link" href="/quotations">Open quotation register</a> }</div> }
        else
        {
            <div class="document-table-wrap" tabindex="0" aria-label="Invoice list">
                <table class="document-table">
                    <thead>
                        <tr>
                            <th scope="col">Reference</th>
                            <th scope="col">Customer</th>
                            <th scope="col">Issued</th>
                            <th scope="col">Status</th>
                            <th scope="col">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td><a href="@($"/invoices/{item.Id}")">@item.Number</a></td>
                                <td>@item.CustomerName</td>
                                <td>@item.IssueDate.ToString("dd MMM yyyy")</td>
                                <td><span class="invoice-status is-@item.Status.ToLowerInvariant()">@item.Status</span></td>
                                <td>@item.Total.ToString("N2") @item.Currency</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <nav class="document-pagination" aria-label="Invoice pages">
                <button type="button" @onclick="PreviousPage" disabled="@(pageNumber == 1)">Previous</button>
                <span>Page @pageNumber of @TotalPages</span>
                <button type="button" @onclick="NextPage" disabled="@(pageNumber >= TotalPages)">Next</button>
            </nav>
        }
    </section>
</main>
