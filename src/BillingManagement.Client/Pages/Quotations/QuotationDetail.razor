@page "/quotations/{Id:guid}"

<PageTitle>Quotation</PageTitle>
<main class="document-page">
    @if (item is null) { <p>@(error ?? "Loading quotation...")</p> }
    else {
        <div class="document-actions no-print"><a href="/quotations">Back</a><button type="button" @onclick="Print">Print / Save PDF</button></div>
        <article class="billing-document">
            <header><div><span class="document-kicker">Quotation</span><h1>@item.Number</h1></div><div><strong>Issue</strong> @item.IssueDate.ToString("dd MMM yyyy")<br /><strong>Valid until</strong> @item.ValidUntil.ToString("dd MMM yyyy")</div></header>
            <section class="document-customer"><h2>Bill to</h2><strong>@item.CustomerName</strong><p>@item.CustomerAddress</p>@if (item.CustomerTaxId is not null) { <p>Tax ID: @item.CustomerTaxId</p> }</section>
            <table><thead><tr><th>Description</th><th>Qty</th><th>Unit price</th><th>Tax</th><th>Total</th></tr></thead><tbody>@foreach (var line in item.Items) { <tr><td>@line.Description</td><td>@line.Quantity</td><td>@line.UnitPrice.ToString("N2")</td><td>@line.TaxAmount.ToString("N2")</td><td>@line.LineTotal.ToString("N2")</td></tr> }</tbody></table>
            <div class="document-totals"><span>Subtotal</span><strong>@item.Subtotal.ToString("N2")</strong><span>Tax</span><strong>@item.TaxTotal.ToString("N2")</strong><span>Total</span><strong>@item.Total.ToString("N2") @item.Currency</strong></div>
        </article>
        <section class="panel no-print"><h2>Create invoice</h2><label>Invoice number <input @bind="invoiceNumber" /></label><label>Issue date <input type="date" @bind="invoiceDate" /></label><label>Due date <input type="date" @bind="dueDate" /></label><button type="button" disabled="@isCreating" @onclick="CreateInvoice">Create invoice</button>@if (error is not null) { <p role="alert">@error</p> }</section>
    }
</main>
