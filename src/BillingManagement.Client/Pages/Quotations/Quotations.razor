@page "/quotations"

<PageTitle>Billing Management | Quotations</PageTitle>
<main class="document-page">
    <header class="document-page-header"><div><h1>Quotation register</h1><p>Offers prepared for customers, ordered for quick review.</p></div><a class="primary-link" href="/quotations/create">Create quotation</a></header>
    <section class="document-register" aria-labelledby="quotation-list-title">
        <header class="document-register-header">
            <div>
                <h2 id="quotation-list-title">Quotation list</h2>
                <p>Offers prepared for customer review.</p>
            </div>
            @if (!isLoading && error is null)
            {
                <span class="document-register-count">@TotalCount @(TotalCount == 1 ? "quotation" : "quotations")</span>
            }
        </header>
        @if (!isLoading && error is null)
        {
            <form class="document-filter" @onsubmit="ApplyFilters" @onsubmit:preventDefault>
                <label class="search-field">
                    <span class="visually-hidden">Search quotations</span>
                    <span class="search-input-shell">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
                        <input type="search" @bind="searchText" @bind:event="oninput" placeholder="Search by reference or customer" />
                    </span>
                </label>
                <button class="search-submit" type="submit">Search</button>
            </form>
        }
        @if (isLoading) { <div class="document-state" role="status"><strong>Opening the register</strong><span>Loading quotation records...</span></div> }
        else if (error is not null) { <div class="document-state is-error" role="alert"><strong>The register could not be opened</strong><span>@error</span></div> }
        else if (items.Count == 0) { <div class="document-state"><strong>@(string.IsNullOrWhiteSpace(searchText) ? "No quotations filed yet" : "No matching quotations")</strong><span>@(string.IsNullOrWhiteSpace(searchText) ? "Create a quotation when you are ready to send an offer." : "Try a different reference or customer name.")</span>@if (string.IsNullOrWhiteSpace(searchText)) { <a class="text-link" href="/quotations/create">Create the first quotation</a> }</div> }
        else
        {
            <div class="document-table-wrap" tabindex="0" aria-label="Quotation list">
                <table class="document-table">
                    <thead>
                        <tr>
                            <th scope="col">Reference</th>
                            <th scope="col">Customer</th>
                            <th scope="col">Issued</th>
                            <th scope="col">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td><a href="@($"/quotations/{item.Id}")">@item.Number</a></td>
                                <td>@item.CustomerName</td>
                                <td>@item.IssueDate.ToString("dd MMM yyyy")</td>
                                <td>@item.Total.ToString("N2") @item.Currency</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <nav class="document-pagination" aria-label="Quotation pages">
                <button type="button" @onclick="PreviousPage" disabled="@(pageNumber == 1)">Previous</button>
                <span>Page @pageNumber of @TotalPages</span>
                <button type="button" @onclick="NextPage" disabled="@(pageNumber >= TotalPages)">Next</button>
            </nav>
        }
    </section>
</main>
