@page "/"
@using BillingManagement.Contracts.BillingDocuments

<PageTitle>Billing Management</PageTitle>

<main class="home-page dashboard-page">
    <header class="dashboard-header"><div><span class="dashboard-kicker">Business overview</span><h1>Good @(DateTime.Now.Hour < 12 ? "morning" : "afternoon").</h1><p>Financial activity from your issued invoices.</p></div><a class="primary-link" href="/quotations">Create quotation</a></header>
    @if (isLoading) { <div class="document-state" role="status"><strong>Preparing your overview</strong><span>Loading invoice activity...</span></div> }
    else if (error is not null) { <div class="document-state is-error" role="alert"><strong>Overview unavailable</strong><span>@error</span></div> }
    else
    {
        <section class="dashboard-summary" aria-label="Invoice summary">
            <article><span>Outstanding</span><strong>@Money(summary.Outstanding)</strong><small>@Count(summary.Outstanding) open @(Count(summary.Outstanding) == 1 ? "invoice" : "invoices")</small></article>
            <article><span>Paid this month</span><strong>@Money(summary.PaidThisMonth)</strong><small>@Count(summary.PaidThisMonth) @(Count(summary.PaidThisMonth) == 1 ? "payment" : "payments") recorded</small></article>
            <article class="@(Count(summary.Overdue) > 0 ? "needs-attention" : string.Empty)"><span>Overdue</span><strong>@Count(summary.Overdue)</strong><small>@Money(summary.Overdue) past due</small></article>
        </section>
        <section class="dashboard-activity" aria-labelledby="recent-invoices-title">
            <header><div><h2 id="recent-invoices-title">Recent invoices</h2><p>The latest billing activity requiring your attention.</p></div><a class="text-link" href="/invoices">View all invoices</a></header>
            @if (summary.RecentInvoices.Count == 0) { <div class="document-state"><strong>No invoices yet</strong><span>Create an invoice from an accepted quotation.</span></div> }
            else { @foreach (var invoice in summary.RecentInvoices) { <a class="dashboard-invoice" href="@($"/invoices/{invoice.Id}")"><span><strong>@invoice.CustomerName</strong><small>@invoice.Number · @invoice.DueDate.ToString("dd MMM yyyy")</small></span><span class="invoice-status is-@invoice.Status.ToLowerInvariant()">@invoice.Status</span><strong>@invoice.Total.ToString("N2") @invoice.Currency</strong></a> } }
        </section>
    }
</main>
